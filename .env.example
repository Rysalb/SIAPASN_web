# ========================================================
# PANDUAN VARIABEL LINGKUNGAN PRODUKSI SIAPASN (RAILWAY / SUPABASE)
# ========================================================

# 1. Database Supabase (PostgreSQL)
# Masukkan URI dari Supabase Dashboard -> Settings -> Database -> Connection String (URI):
# - DATABASE_URL (Transaction Pooler - port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# - DIRECT_URL (Session Direct - port 5432, untuk migrasi Prisma):
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Keamanan Kunci Sesi & JWT (WAJIB DIGANTI DI RAILWAY VARIABLES)
# Gunakan string acak kriptografis 64-karakter (contoh: openssl rand -hex 32)
JWT_SECRET="siapasn-production-super-secret-jwt-key-change-me"

# 3. Environment Mode
NODE_ENV="production"

# 4. Metadata Aplikasi
NEXT_PUBLIC_APP_NAME="SIAPASN"
NEXT_PUBLIC_APP_TAGLINE="Platform Simulasi CAT & Akademi Mandiri Calon ASN"


