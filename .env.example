# ========================================================
# PANDUAN KONEKSI DATABASE SIAPASN (SUPABASE / POSTGRESQL)
# ========================================================

# 1. Mode Lokal Standalone (Default saat ini):
DATABASE_URL="file:./dev.db"

# 2. Mode Cloud Supabase (PostgreSQL):
# Salin URI dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Kunci Keamanan Sesi & JWT
JWT_SECRET="siapasn-jwt-secret-key-production-ready-2024"

# Metadata Aplikasi
NEXT_PUBLIC_APP_NAME="SIAPASN"
NEXT_PUBLIC_APP_TAGLINE="Persiapkan Diri, Raih Mimpi Menjadi ASN"

