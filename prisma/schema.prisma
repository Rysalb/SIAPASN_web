generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("USER") // SUPER_ADMIN, ADMIN, USER
  avatar       String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      UserProfile?
  documents    Document[]
  attempts     ExamAttempt[]
  favorites    UserFavorite[]
  progress     MaterialProgress[]
  auditLogs    AuditLog[]

  @@index([role])
}

model UserProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  province       String?
  educationLevel String?
  createdAt      DateTime @default(now())
}

model Document {
  id               String            @id @default(uuid())
  filename         String
  storagePath      String
  fileSize         Int
  totalPages       Int               @default(1)
  documentType     String            @default("SOAL") // SOAL, MATERI, CAMPURAN
  uploadedById     String?
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id])
  processingStatus String            @default("COMPLETED") // UPLOADED, QUEUED, PROCESSING, REVIEW, COMPLETED, FAILED
  processingError  String?
  extractedData    String?           // JSON string of parsed preview before final import
  createdAt        DateTime          @default(now())
  processedAt      DateTime?
  imports          DocumentImport[]
  questions        Question[]
  materials        Material[]

  @@index([processingStatus])
  @@index([documentType])
}

model DocumentImport {
  id             String    @id @default(uuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  totalExtracted Int       @default(0)
  totalSuccess   Int       @default(0)
  totalFailed    Int       @default(0)
  totalApproved  Int       @default(0)
  importStatus   String    @default("COMPLETED")
  createdAt      DateTime  @default(now())
}

model Category {
  id            String        @id @default(uuid())
  name          String        // TWK, TIU, TKP
  code          String        @unique // TWK, TIU, TKP
  description   String?
  subcategories Subcategory[]
  questions     Question[]
  materials     Material[]
}

model Subcategory {
  id         String     @id @default(uuid())
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  questions  Question[]
  materials  Material[]
}

model Question {
  id            String                @id @default(uuid())
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?          @relation(fields: [subcategoryId], references: [id])
  documentId    String?
  document      Document?             @relation(fields: [documentId], references: [id])
  sourcePage    Int?
  questionText  String
  questionImage String?
  explanation   String?
  difficulty    String                @default("MEDIUM") // EASY, MEDIUM, HARD
  status        String                @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  options       QuestionOption[]
  answers       QuestionAnswer[]
  packageLinks  ExamPackageQuestion[]
  examAnswers   ExamAnswer[]
  favorites     UserFavorite[]

  @@index([categoryId, status])
  @@index([subcategoryId])
  @@index([documentId])
  @@index([difficulty])
}

model QuestionOption {
  id          String       @id @default(uuid())
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionLabel String       // A, B, C, D, E
  optionText  String
  scoreWeight Float        @default(0) // 0 or 5 for TWK/TIU; 1 to 5 for TKP
  isCorrect   Boolean      @default(false)
  examAnswers ExamAnswer[]
}

model QuestionAnswer {
  id              String   @id @default(uuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctOptionId String
}

model Material {
  id              String             @id @default(uuid())
  title           String
  categoryId      String
  category        Category           @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?       @relation(fields: [subcategoryId], references: [id])
  documentId      String?
  document        Document?          @relation(fields: [documentId], references: [id])
  description     String?
  content         String             // Full markdown or HTML text
  status          String             @default("PUBLISHED") // DRAFT, PUBLISHED
  readTimeMinutes Int                @default(10)
  orderNumber     Int                @default(1)
  createdAt       DateTime           @default(now())
  chapters        MaterialChapter[]
  progress        MaterialProgress[]

  @@index([categoryId, status])
  @@index([subcategoryId])
}

model MaterialChapter {
  id          String             @id @default(uuid())
  materialId  String
  material    Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title       String
  content     String
  orderNumber Int                @default(1)
  progress    MaterialProgress[]

  @@index([materialId, orderNumber])
}

model MaterialProgress {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     MaterialChapter? @relation(fields: [chapterId], references: [id])
  isCompleted Boolean          @default(false)
  completedAt DateTime?

  @@index([userId, materialId])
}

model ExamPackage {
  id               String                @id @default(uuid())
  title            String
  description      String?
  durationMinutes  Int                   @default(100)
  examType         String                @default("SKD_COMPLETE") // SKD_COMPLETE, TWK_DRILL, TIU_DRILL, TKP_DRILL, CUSTOM
  totalQuestions   Int                   @default(110)
  isRandomized     Boolean               @default(true)
  passingGradeTwk  Float                 @default(65)
  passingGradeTiu  Float                 @default(80)
  passingGradeTkp  Float                 @default(166)
  status           String                @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt        DateTime              @default(now())
  questions        ExamPackageQuestion[]
  attempts         ExamAttempt[]
}

model ExamPackageQuestion {
  id            String      @id @default(uuid())
  examPackageId String
  examPackage   ExamPackage @relation(fields: [examPackageId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderNumber   Int         @default(1)

  @@index([examPackageId, orderNumber])
  @@index([questionId])
}

model ExamAttempt {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examPackageId String
  examPackage   ExamPackage  @relation(fields: [examPackageId], references: [id], onDelete: Cascade)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  expiresAt     DateTime
  status        String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TIMEOUT, ABANDONED
  totalScore    Float?
  createdAt     DateTime     @default(now())
  answers       ExamAnswer[]
  result        ExamResult?

  @@index([userId, status])
  @@index([examPackageId])
  @@index([createdAt])
}

model ExamAnswer {
  id               String          @id @default(uuid())
  attemptId        String
  attempt          ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  isMarked         Boolean         @default(false) // Ragu-ragu
  answeredAt       DateTime        @default(now())

  @@index([attemptId])
  @@index([questionId])
}

model ExamResult {
  id               String      @id @default(uuid())
  attemptId        String      @unique
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  twkScore         Float       @default(0)
  tiuScore         Float       @default(0)
  tkpScore         Float       @default(0)
  totalScore       Float       @default(0)
  isPassed         Boolean     @default(false)
  correctCount     Int         @default(0)
  incorrectCount   Int         @default(0)
  unansweredCount  Int         @default(0)
  createdAt        DateTime    @default(now())

  @@index([totalScore(sort: Desc)])
  @@index([isPassed])
}

model UserFavorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

